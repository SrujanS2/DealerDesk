# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dealerdesk
SUPPLIER_API_URL=http://127.0.0.1:8099
SUPPLIER_API_KEY=dev-supplier-key
DJANGO_SECRET_KEY=change-me

# LLM for the Dealer Assistant. This project uses Google Gemini (gemini-3.8-flash) by default.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Optional: force a provider (gemini | openai | anthropic | groq) and/or a model id
LLM_PROVIDER=
LLM_MODEL=
